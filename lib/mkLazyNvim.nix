# mkLazyNvim: plugins are declared as Nix; Nix fetches them and generates init.lua, in which every
# plugin spec carries its /nix/store path (`dir = ...`). lazy.nvim only loads them.
#
# A plugin is a derivation/path, or an attrset:
#   { plugin = drv; name ? plugin.pname; dependencies ? [ name | plugin ];
#     config ? "lua body"; init ? "lua body"; opts ? { ... } | "lua body"; <any other lazy field> }
# Strings given to config/init/opts become `function(plugin, opts) <body> end`. Any other lazy field
# (event, cmd, ft, keys, lazy, priority, cond, ...) is serialized as Lua data; use `raw "<lua expr>"`
# for non-data values. In an attrset, keys `_1`, `_2`, ... become positional entries (for `keys`).
{ pkgs
, lib ? pkgs.lib
, neovim ? pkgs.neovim
, plugins ? [ ]           # list of plugins, see above
, extraPlugins ? { }      # { "name" = path-or-drv; } sugar for plugins nixpkgs lacks (no lazy fields)
, extraPackages ? [ ]     # put on PATH for nvim (LSP servers, ripgrep, ...)
, mergeDependencies ? [ "nvim-treesitter" ]  # plugins whose `dependencies` (grammars) join one dir
, configDir ? null        # lua modules etc. (lua/, after/, ftplugin/ ...) merged next to the generated init.lua
, importSpecs ? [ ]       # lua modules under configDir/lua whose plugin specs lazy.nvim imports (`{ import = "plugins" }`)
, extraInitLuaPre ? ""    # lua run before lazy.setup (options, leader, ...)
, extraInitLua ? ""       # lua run after lazy.setup (e.g. `require("keymaps")`)
, lazyOpts ? { }          # merged over the default lazy.setup() options
, appName ? "nix-lazy-nvim"
, binName ? "nvim"
}:
let
  raw = expr: { _type = "lua-inline"; inherit expr; };

  # ---- Lua serializer (scalars and strings via nixpkgs' toLua) ----
  isRaw = v: builtins.isAttrs v && (v._type or null) == "lua-inline";
  toLua = v:
    if isRaw v then v.expr
    else if builtins.isList v then "{ ${lib.concatMapStringsSep ", " toLua v} }"
    else if builtins.isAttrs v then
      let
        names = builtins.attrNames v;
        isPos = n: builtins.match "_[0-9]+" n != null;
        pos = lib.sort (a: b: lib.toInt (lib.removePrefix "_" a) < lib.toInt (lib.removePrefix "_" b)) (lib.filter isPos names);
        named = lib.filter (n: !isPos n) names;
      in "{ ${lib.concatStringsSep ", " (map (n: toLua v.${n}) pos ++ map (n: "[${toLua n}] = ${toLua v.${n}}") named)} }"
    else lib.generators.toLua { } v;

  fn = body: raw "function(plugin, opts) ${body} end";
  asFn = v: if builtins.isString v then fn v else v;

  # ---- normalize plugin entries ----
  norm = p:
    if lib.isDerivation p then { name = p.pname or p.name; plugin = p; }
    else if p ? plugin then { name = p.plugin.pname or p.plugin.name or "plugin"; } // p
    else throw "nix-lazy-nvim: plugin entries must be a derivation or { plugin = ...; }";

  depEntries = e: map (d: if builtins.isString d then null else norm d) (e.dependencies or [ ]);
  expand = e: [ e ] ++ lib.concatMap expand (lib.filter (x: x != null) (depEntries e));

  top = map norm plugins ++ lib.mapAttrsToList (name: plugin: { inherit name plugin; }) extraPlugins;
  # dedupe by name, first wins (user entries precede auto-added dependency entries)
  entries = lib.foldl' (acc: e: if lib.any (a: a.name == e.name) acc then acc else acc ++ [ e ]) [ ] (lib.concatMap expand top);

  withDeps = e:
    if builtins.elem e.name mergeDependencies && e.plugin ? dependencies
    then pkgs.symlinkJoin { inherit (e) name; paths = [ e.plugin ] ++ e.plugin.dependencies; }
    else e.plugin;

  lazyDrv = (lib.findFirst (e: e.name == "lazy.nvim") { plugin = pkgs.vimPlugins.lazy-nvim; } entries).plugin;

  specOf = e:
    let
      own = removeAttrs e [ "plugin" "name" "dependencies" "config" "init" "opts" ];
      deps = map (d: if builtins.isString d then d else (norm d).name) (e.dependencies or [ ]);
    in
    own // { name = e.name; dir = "${withDeps e}"; }
    // lib.optionalAttrs (e ? dependencies) { dependencies = deps; }
    // lib.optionalAttrs (e ? config) { config = asFn e.config; }
    // lib.optionalAttrs (e ? init) { init = asFn e.init; }
    // lib.optionalAttrs (e ? opts) { opts = asFn e.opts; };

  spec = map specOf entries ++ map (m: { import = m; }) importSpecs;

  setupOpts = lib.recursiveUpdate {
    install.missing = false;
    checker.enabled = false;
    change_detection.enabled = false;
    lockfile = raw ''vim.fn.stdpath("state") .. "/lazy-lock.json"'';
  } lazyOpts;

  initLua = pkgs.writeText "init.lua" ''
    -- Generated by nix-lazy-nvim. Do not edit: declare plugins in Nix, add Lua via configDir / extraInitLua.
    ${extraInitLuaPre}
    vim.opt.rtp:prepend(${toLua "${lazyDrv}"})
    require("lazy").setup(${toLua spec}, ${toLua setupOpts})
    ${extraInitLua}
  '';

  configRoot = pkgs.runCommand "nvim-config-root" { } ''
    mkdir -p $out/${appName}
    ${lib.optionalString (configDir != null) ''
      if [ -e ${configDir}/init.lua ]; then
        echo "nix-lazy-nvim: configDir must not contain init.lua (it is generated; use extraInitLua / lua modules)" >&2
        exit 1
      fi
      for f in ${configDir}/*; do ln -s "$f" $out/${appName}/; done
    ''}
    ln -s ${initLua} $out/${appName}/init.lua
  '';
in
pkgs.writeShellScriptBin binName ''
  export NVIM_APPNAME=${appName}
  export XDG_CONFIG_HOME=${configRoot}
  ${lib.optionalString (extraPackages != [ ]) ''export PATH=${lib.makeBinPath extraPackages}:$PATH''}
  exec ${neovim}/bin/nvim "$@"
''
